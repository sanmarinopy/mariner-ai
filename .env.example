# Copiar a .env y completar. NUNCA subir .env a GitHub (ya está en .gitignore).
# Acá van SÓLO los datos de esta unidad. La conducta (personalidad, voz, avisos, modelos)
# está en profiles/<PROFILE>.toml. Cualquier variable de abajo, si se completa, pisa al perfil.

# --- Unidad ---
DEVICE_ID=dev-cristian
PROFILE=default

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
# Voces: marin, cedar, coral, nova, sage, shimmer, ballad, verse, alloy, ash, echo, fable, onyx
OPENAI_TTS_VOICE=
OPENAI_TTS_STYLE=

# --- Asistente ---
ASSISTANT_NAME=
LANGUAGE=
# true = sólo responde si la frase contiene "Mariner" (útil con micrófono abierto)
REQUIRE_WAKE_WORD=

# --- Juego ---
GAME_PACK=elite_dangerous
# local = lee el Journal en esta PC | bridge = lo recibe desde la PC gamer (python -m mariner.bridge)
GAME_SOURCE=local
# Vacío = %USERPROFILE%\Saved Games\Frontier Developments\Elite Dangerous
ELITE_JOURNAL_DIR=

# --- Reconocimiento de quién habla (opcional) ---
# Registrar voces con: python -m mariner.tools.enroll --name cristian
SPEAKER_ID=false
OPENAI_SPEAKER_MODEL=
ONLY_KNOWN_SPEAKERS=false

# --- Audio ---
# Índice o nombre del micrófono (ver: python -m mariner.tools.mic_test)
MIC_DEVICE=
VAD_THRESHOLD=0.015
VAD_SILENCE_MS=900

# --- Interfaz ---
HOST=127.0.0.1
PORT=8765
