# Copiar a .env y completar. NUNCA subir .env a GitHub (ya está en .gitignore).

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voces: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_TTS_VOICE=nova
OPENAI_TTS_STYLE=Voz de IA de a bordo: calma, precisa, levemente cálida. Frases cortas, tono de cabina.

# --- Asistente ---
ASSISTANT_NAME=Mariner
LANGUAGE=es
# true = sólo responde si la frase contiene "Mariner" (útil con micrófono abierto)
REQUIRE_WAKE_WORD=false

# --- Juego ---
GAME_PACK=elite_dangerous
# local = lee el Journal en esta PC | bridge = lo recibe desde la PC gamer (python -m mariner.bridge)
GAME_SOURCE=local
# Vacío = %USERPROFILE%\Saved Games\Frontier Developments\Elite Dangerous
ELITE_JOURNAL_DIR=

# --- Reconocimiento de quién habla (opcional) ---
# Registrar voces con: python -m mariner.tools.enroll --name cristian
SPEAKER_ID=false
OPENAI_SPEAKER_MODEL=gpt-4o-transcribe-diarize
ONLY_KNOWN_SPEAKERS=false

# --- Audio ---
# Índice o nombre del micrófono (ver: python -m mariner.tools.mic_test)
MIC_DEVICE=
VAD_THRESHOLD=0.015
VAD_SILENCE_MS=900

# --- Interfaz ---
HOST=127.0.0.1
PORT=8765
